<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/admin_logs_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Administratora logs"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="100dp"
        tools:layout_editor_absoluteY="25dp" />

    <TextView
        android:id="@+id/adming_logs_text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lietotaji"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="169dp"
        tools:layout_editor_absoluteY="94dp" />

    <Button
        android:id="@+id/search_button"
        android:layout_width="124dp"
        android:layout_height="48dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="360dp"
        android:layout_marginEnd="56dp"
        android:background="#D01313"
        android:text="Meklet"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/delete_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/admin_logs_text" />

    <Button
        android:id="@+id/delete_button"
        android:layout_width="123dp"
        android:layout_height="48dp"
        android:layout_marginEnd="28dp"
        android:background="#D12626"
        android:text="Dzēst"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="417dp" />

    <EditText
        android:id="@+id/admin_logs_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/admin_logs_text3" />

    <TextView
        android:id="@+id/admin_logs_text3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="236dp"
        android:text="Meklet/Dzēst kontu"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@+id/admin_logs_text"
        tools:layout_editor_absoluteX="100dp" />

    <ScrollView
        android:id="@+id/Lietotaju_view"
        android:layout_width="332dp"
        android:layout_height="131dp"
        android:layout_marginTop="76dp"
        android:outlineAmbientShadowColor="#1B1A1A"
        android:outlineSpotShadowColor="#DB3232"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/admin_logs_text">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>